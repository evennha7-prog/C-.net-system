# ==========================================
# PCCFPI STORE - APPLICATION ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================
# Copy this file to .env and fill in your actual credentials.

# Store Profile
APP_ENV=development
STORE_NAME=PCCFPI STORE
STORE_PHONE=+1 (555) 019-2834
STORE_EMAIL=support@pccfpistore.com
STORE_ADDRESS=100 Retail Boulevard, Suite 400

# POS & Financial Settings
CURRENCY_SYMBOL=$
TAX_RATE_PERCENTAGE=8.0
RECEIPT_HEADER=THANK YOU FOR SHOPPING AT PCCFPI STORE!
RECEIPT_FOOTER=Returns accepted within 30 days with receipt.
AUTO_PRINT_RECEIPT=true

# Security / API Configuration
API_URL=https://api.pccfpistore.com/v1
API_KEY=your_api_key_here
DEFAULT_LANGUAGE=English

# Database Configuration (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=your_database_host_here
DB_PORT=5432
DB_DATABASE=your_database_name
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password_here
